{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Spring Boot - NetixBackendApplication",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "mainClass": "cz.netix.netixbackend.NetixBackendApplication",
      "projectName": "netix-backend",
      "args": "",
      "envFile": "${workspaceFolder}/netix-backend/.env",
      "env": {
        "SPRING_PROFILES_ACTIVE": "dev"
      }
    },
    {
      "type": "pwa-msedge",
      "request": "launch",
      "name": "React Vite App",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/netix-react/src",
      "preLaunchTask": "Run Vite"
    }
  ],
  "compounds": [
    {
      "name": "Netix Fullstack App",
      "configurations": [
        "Spring Boot - NetixBackendApplication",
        "React Vite App"
      ]
    },
    {
  "name": "React App + Edge DevTools",
  "configurations": [
    "React Vite App (Edge)",
    "Open Edge DevTools"
  ]
}
  ]
}